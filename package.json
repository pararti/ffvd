{
  "name": "ffvd",
  "version": "1.1.0",
  "private": true,
  "description": "Firefox video downloader backed by yt-dlp",
  "scripts": {
    "test": "python3 -m unittest discover -s host",
    "lint": "npx --yes web-ext@8 lint --source-dir extension",
    "build": "npx --yes web-ext@8 build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "sign": "./sign.sh",
    "run": "npx --yes web-ext@8 run --source-dir extension"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pararti/ffdv.git"
  }
}
